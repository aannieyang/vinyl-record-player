; Full-duplex I2S SLAVE: PCM1808 supplies BCK/LRCK to Pico and PCM5102A.
; Pico still supplies ADC SCKI/MCLK independently through GPOUT0.
; Physical Pico pins: 21=BCK/GP16, 22=LRCK/GP17, 24=ADC DOUT/GP18,
; 25=DAC DIN/GP19. WAIT GPIO operands are absolute GPIO numbers.
;
; Run at clk_sys (120 MHz), not at MCLK: WAIT instructions follow the external
; 3 MHz BCK. Never drive either clock pin. Reacquire a falling LRCK each frame
; so startup in an arbitrary slot cannot permanently swap channels.
;
; Capture/transmit 32 bits starting in the I2S delay slot after each LRCK edge:
; RX/TX bits 30..7 hold signed PCM24; bit31 belongs to the previous channel.
; TX bit31 and bits6..0 must be zero. Sample ADC after rising BCK and change
; DAC DIN after falling BCK, while BCK is low.
;
; Autopush/autopull may stall if the CPU falls behind. External clocks CANNOT
; pause: that can corrupt data within the frame. Inspect RXSTALL/TXSTALL;
; the next wrap reacquires the left boundary, but does not recover lost audio.
.program i2s_duplex

.wrap_target
    wait 1 gpio 19
    wait 0 gpio 19       ; left transition, one BCK before the left MSB
    set x, 31
left_loop:
    wait 0 gpio 20
    out pins, 1
    wait 1 gpio 20
    in pins, 1
    jmp x-- left_loop

    set x, 31
right_loop:
    wait 0 gpio 20       ; next falling edge is the right transition
    out pins, 1
    wait 1 gpio 20
    in pins, 1
    jmp x-- right_loop
.wrap
